# Sem listagem de pastas
Options -Indexes

# Arquivos internos: dump do banco, documentação e dependências
<FilesMatch "\.(sql|md|json|lock)$">
    Require all denied
</FilesMatch>

# Diagnóstico do banco: só a partir do próprio computador
<Files "check.php">
    Require local
</Files>


# URLs amigáveis: /home abre a loja e /painel abre o login do vendedor
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^home/$ home [R=301,L]
    RewriteRule ^home$ index.php?controller=loja&action=index [L,QSA]
    RewriteRule ^painel/$ painel [R=301,L]
    RewriteRule ^painel$ index.php?controller=auth&action=form [L,QSA]
</IfModule>